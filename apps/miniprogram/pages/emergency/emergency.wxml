<view class="page">
  <view class="emergency-hero">
    <text class="risk {{riskLevel}}">{{riskText}}</text>
    <text class="emergency-title">{{event ? '已触发急性风险流程' : '急救链路待演练'}}</text>
    <text class="emergency-copy">{{summary}}</text>
    <view class="button-row">
      <button class="btn danger" bindtap="simulate">运行急救演练</button>
    </view>
  </view>

  <view class="section metric-grid">
    <view class="metric danger-metric" wx:for="{{vitals}}" wx:key="label">
      <text class="metric-label">{{item.label}}</text>
      <text class="metric-value">{{item.value}}<text class="metric-unit">{{item.unit}}</text></text>
    </view>
  </view>

  <view class="section card">
    <view class="section-title">
      <text>通知链路</text>
      <text>{{eventStatus}}</text>
    </view>
    <view class="list">
      <view class="list-item chain-item {{item.done ? 'done' : ''}}" wx:for="{{chain}}" wx:key="title">
        <view class="chain-dot"></view>
        <view class="list-content">
          <text class="list-title">{{item.title}}</text>
          <text class="list-desc">{{item.desc}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="section card" wx:if="{{event}}">
    <view class="section-title">
      <text>事件摘要</text>
      <text>{{event.id}}</text>
    </view>
    <view class="list">
      <view class="list-item" wx:for="{{event.actionList}}" wx:key="*this">
        <view class="list-dot"></view>
        <view class="list-content">
          <text class="list-title">{{item}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
