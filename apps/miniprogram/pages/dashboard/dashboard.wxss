.patient-row {
  margin-top: 24rpx;
}

.patient-picker {
  display: inline-flex;
  max-width: 100%;
  height: 64rpx;
  align-items: center;
  padding: 0 18rpx;
  color: #173e3d;
  background: #dff3ef;
  border-radius: 12rpx;
  font-size: 25rpx;
  font-weight: 760;
}

.risk-card {
  display: flex;
  justify-content: space-between;
  gap: 22rpx;
}

.risk-title {
  display: block;
  margin-top: 18rpx;
  color: #657878;
  font-size: 24rpx;
}

.risk-score {
  display: block;
  margin-top: 6rpx;
  color: #18212f;
  font-size: 72rpx;
  font-weight: 900;
  line-height: 1;
}

.risk-meta {
  display: grid;
  gap: 10rpx;
  min-width: 248rpx;
  color: #647776;
  font-size: 24rpx;
  line-height: 1.4;
}

.vital {
  background: #f8fbfa;
}

.trend-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-height: 58rpx;
}

.trend-day {
  width: 70rpx;
  color: #647776;
  font-size: 23rpx;
}

.trend-bars {
  display: grid;
  flex: 1;
  gap: 8rpx;
}

.bar-bg {
  height: 12rpx;
  overflow: hidden;
  background: #e3ece9;
  border-radius: 999rpx;
}

.bar {
  height: 100%;
  border-radius: 999rpx;
}

.risk-bar {
  background: #bd4d3b;
}

.hrv-bar {
  background: #4575b7;
}

.trend-value {
  width: 48rpx;
  color: #263a39;
  font-size: 24rpx;
  font-weight: 760;
  text-align: right;
}
