<view class="page dashboard-page">
  <view class="hero">
    <text class="eyebrow">Vitalife 小程序端</text>
    <text class="hero-title">多模态心血管与抗衰健康管理</text>
    <text class="hero-subtitle">{{summary}}</text>
    <view class="patient-row" wx:if="{{patients.length}}">
      <picker mode="selector" range="{{patients}}" range-key="name" value="{{selectedIndex}}" bindchange="onPatientChange">
        <view class="patient-picker">{{patient.name}} · {{patient.age}}岁 · {{patient.plan}}</view>
      </picker>
    </view>
    <view class="button-row">
      <button class="btn primary" bindtap="handleRunAnalysis">运行智能体</button>
      <button class="btn danger" bindtap="goEmergency">急救演练</button>
    </view>
  </view>

  <view class="section card risk-card" wx:if="{{patient}}">
    <view>
      <text class="risk {{riskLevel}}">{{riskText}}</text>
      <text class="risk-title">综合风险分</text>
      <text class="risk-score">{{riskScore}}</text>
    </view>
    <view class="risk-meta">
      <text>血管年龄 +{{vascularAgeDelta}} 岁</text>
      <text>FaceAge {{patient.baseline.faceAge}} 岁</text>
      <text>照护人 {{patient.caregiver}}</text>
    </view>
  </view>

  <view class="section metric-grid">
    <view class="metric" wx:for="{{metrics}}" wx:key="label">
      <text class="metric-label">{{item.label}}</text>
      <text class="metric-value">{{item.value}}<text class="metric-unit">{{item.unit}}</text></text>
    </view>
  </view>

  <view class="section">
    <view class="section-title">
      <text>实时体征</text>
      <text>{{patient.latest.updatedAt}}</text>
    </view>
    <view class="metric-grid">
      <view class="metric vital" wx:for="{{vitals}}" wx:key="label">
        <text class="metric-label">{{item.label}}</text>
        <text class="metric-value">{{item.value}}<text class="metric-unit">{{item.unit}}</text></text>
      </view>
    </view>
  </view>

  <view class="section card">
    <view class="section-title">
      <text>7日趋势</text>
      <text>风险 / HRV</text>
    </view>
    <view class="trend-row" wx:for="{{trendRows}}" wx:key="id">
      <text class="trend-day">{{item.day}}</text>
      <view class="trend-bars">
        <view class="bar-bg"><view class="bar risk-bar" style="width: {{item.riskWidth}};"></view></view>
        <view class="bar-bg"><view class="bar hrv-bar" style="width: {{item.hrvWidth}};"></view></view>
      </view>
      <text class="trend-value">{{item.risk}}</text>
    </view>
  </view>

  <view class="section card">
    <view class="section-title">
      <text>闭环任务</text>
      <text>用户端同步</text>
    </view>
    <view class="list">
      <view class="list-item" wx:for="{{actions}}" wx:key="*this">
        <view class="list-dot"></view>
        <view class="list-content">
          <text class="list-title">{{item}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
