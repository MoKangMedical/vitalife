.os-layer,
.template-card {
  display: grid;
  gap: 10rpx;
  padding: 20rpx;
  background: #f8fbfa;
  border: 1rpx solid #e2ebe8;
  border-radius: 12rpx;
}

.os-layer + .os-layer,
.template-card + .template-card {
  margin-top: 14rpx;
}

.os-kicker {
  color: #227469;
  font-size: 23rpx;
  font-weight: 850;
}

.os-title {
  color: #18212f;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.3;
}

.tag-row {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}

.tag-row text {
  min-height: 42rpx;
  padding: 7rpx 12rpx;
  color: #24403e;
  background: #edf6f3;
  border: 1rpx solid #d5e6e1;
  border-radius: 999rpx;
  font-size: 22rpx;
}
