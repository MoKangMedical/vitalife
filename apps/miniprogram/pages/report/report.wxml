<view class="page">
  <view class="report-sheet" wx:if="{{patient}}">
    <text class="report-kicker">Vitalife 周期健康报告</text>
    <text class="report-title">{{patient.name}} · 心血管与抗衰综合评估</text>
    <text class="report-meta">{{patient.age}}岁 · {{patient.plan}} · 照护人 {{patient.caregiver}}</text>

    <view class="summary-grid">
      <view class="summary-item">
        <text>综合风险分</text>
        <text>{{riskScore}}</text>
      </view>
      <view class="summary-item">
        <text>血管年龄偏离</text>
        <text>{{vascularAgeDelta}}</text>
      </view>
      <view class="summary-item">
        <text>最近血压</text>
        <text>{{patient.latest.systolic}}/{{patient.latest.diastolic}}</text>
      </view>
    </view>

    <view class="report-block">
      <view class="section-title">
        <text>融合结论</text>
        <text class="risk {{riskLevel}}">{{riskText}}</text>
      </view>
      <text class="report-copy">{{summary}}</text>
    </view>

    <view class="report-block">
      <view class="section-title">
        <text>重点干预</text>
        <text>闭环任务</text>
      </view>
      <view class="list">
        <view class="list-item" wx:for="{{actions}}" wx:key="*this">
          <view class="list-dot"></view>
          <view class="list-content">
            <text class="list-title">{{item}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="report-block">
      <view class="section-title">
        <text>趋势摘要</text>
        <text>7日风险</text>
      </view>
      <view class="report-trend" wx:for="{{trendRows}}" wx:key="id">
        <text>{{item.day}}</text>
        <view class="trend-track"><view class="trend-fill" style="width: {{item.riskWidth}};"></view></view>
        <text>{{item.risk}}</text>
      </view>
    </view>
  </view>

  <view class="section card">
    <view class="section-title">
      <text>报告操作</text>
      <text>医生复核后发布</text>
    </view>
    <view class="list">
      <view class="list-item" wx:for="{{operations}}" wx:key="title">
        <view class="list-dot"></view>
        <view class="list-content">
          <text class="list-title">{{item.title}}</text>
          <text class="list-desc">{{item.desc}}</text>
        </view>
      </view>
    </view>
    <view class="button-row">
      <button class="btn primary" bindtap="markReview">标记待医生复核</button>
      <button class="btn" bindtap="goAgents">查看证据</button>
    </view>
  </view>
</view>
